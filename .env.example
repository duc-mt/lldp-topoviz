# ==============================================================================
# LLDP TopoViz - Environment Variables Template
# Copy this file to .env and replace placeholders with actual values:
#   cp .env.example .env && chmod 600 .env
# ==============================================================================

# Device SSH Credentials (overrides values in config/settings.yaml)
LLDP_MAPPER_USERNAME="noc_operator"
LLDP_MAPPER_PASSWORD="CHANGE_ME_PASSWORD"
LLDP_MAPPER_SECRET=""

# Telegram Alerting Pipeline Configuration
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN="000000000:AAFg-XXXXXXXXXXXXXXXXXXXXXXXXXX"
TELEGRAM_CHAT_ID="-1001234567890"
TELEGRAM_MESSAGE_THREAD_ID=""
TELEGRAM_MIN_SEVERITY="warning"
TELEGRAM_COOLDOWN_SECONDS=300
TELEGRAM_SILENT=false
TELEGRAM_SEND_IMAGE=true
TELEGRAM_PROXY_URL=""

# Embedded web server (python3 main.py --serve). --port / --bind on the command line win.
# The crawl trigger uses the credentials above: keep the bind address on this machine
# unless the server sits behind something that authenticates people.
LLDP_MONITOR_PORT=8080
LLDP_MONITOR_BIND="127.0.0.1"
